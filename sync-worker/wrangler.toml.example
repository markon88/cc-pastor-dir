name             = "eadventist-sync"
main             = "src/index.js"
compatibility_date = "2024-01-01"
account_id       = "<YOUR_CLOUDFLARE_ACCOUNT_ID>"

[[d1_databases]]
binding       = "DB"
database_name = "cc-pastor-dir-auth"
database_id   = "<YOUR_D1_DATABASE_ID>"

[triggers]
# Tuesday and Friday at 9:00 UTC = 4:00 AM EST / 5:00 AM EDT
crons = ["0 9 * * 3,6"]

# Secrets to set via: wrangler secret put <NAME>
#   EADVENTIST_USER
#   EADVENTIST_PASS
#   NOTIFY_WEBHOOK_URL   (optional — POST payload on new items)
#   SYNC_SECRET          (protects the manual HTTP trigger)

# Copy this file to wrangler.toml (gitignored) and fill in real values.
# account_id can also be omitted — wrangler will use your logged-in account.
